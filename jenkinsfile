pipeline {
  agent any

  environment {
    DOCKER_HUB_CREDENTIALS = 'dockerhub-final-proj'  // whatever ID you chose
    DOCKER_IMAGE           = 'hamzah64/ml-ops-final-proj'
    IMAGE_TAG              = 'latest'
  }

  triggers {
    // Use SCM polling; GitHub hook trigger will enqueue a scan
    pollSCM('H/5 * * * *')
  }

  stages {
    stage('Validate PR Target') {
      when {
        allOf {
          expression { env.CHANGE_ID }                // only run on PRs
          changeRequest target: 'test'               // that target the test branch
        }
      }
      steps {
        echo "Building PR #${env.CHANGE_ID} targeting ${env.CHANGE_TARGET}"
      }
    }

    stage('Checkout') {
      when { changeRequest target: 'test' }
      steps { checkout scm }
    }

    stage('Fetch Data') {
      when { changeRequest target: 'test' }
      steps {
        script {
          if (isUnix()) {
            sh 'pip3 install --upgrade pip'
            sh 'pip3 install -r requirements.txt dvc'
            sh 'dvc pull'
          } else {
            bat 'python -m pip install --upgrade pip'
            bat 'python -m pip install -r requirements.txt dvc'
            bat 'python -m dvc pull'
          }
        }
      }
    }

    stage('Build Docker Image') {
      when { changeRequest target: 'test' }
      steps {
        script {
          docker.build("${DOCKER_IMAGE}:${IMAGE_TAG}")
        }
      }
    }

    stage('Push to Docker Hub') {
      when { changeRequest target: 'test' }
      steps {
        withCredentials([usernamePassword(
          credentialsId: env.DOCKER_HUB_CREDENTIALS,
          usernameVariable: 'DOCKERHUB_USER',
          passwordVariable: 'DOCKERHUB_PASS'
        )]) {
          sh """
            docker login -u $DOCKERHUB_USER -p $DOCKERHUB_PASS
            docker push ${DOCKER_IMAGE}:${IMAGE_TAG}
          """
        }
      }
    }
  }

  post {
    success {
      echo "✅ PR built & image pushed: ${DOCKER_IMAGE}:${IMAGE_TAG}"
    }
    failure {
      echo "❌ Pipeline failed for PR #${env.CHANGE_ID}"
    }
  }
}
